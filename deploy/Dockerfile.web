# The website (Next.js). The public address is baked in at build time:
#   docker build -f deploy/Dockerfile.web --build-arg NEXT_PUBLIC_API_URL=https://your-domain/api .
FROM node:22-slim
RUN corepack enable
WORKDIR /app
COPY . .
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
# our contact details, shown on the site and at the bottom of every screen (optional)
ARG NEXT_PUBLIC_CONTACT_EMAIL=""
ARG NEXT_PUBLIC_CONTACT_WHATSAPP=""
ARG NEXT_PUBLIC_CONTACT_PHONE=""
ARG NEXT_PUBLIC_CONTACT_HOURS=""
ARG NEXT_PUBLIC_CONTACT_LOCATION=""
ENV NEXT_PUBLIC_CONTACT_EMAIL=$NEXT_PUBLIC_CONTACT_EMAIL NEXT_PUBLIC_CONTACT_WHATSAPP=$NEXT_PUBLIC_CONTACT_WHATSAPP NEXT_PUBLIC_CONTACT_PHONE=$NEXT_PUBLIC_CONTACT_PHONE NEXT_PUBLIC_CONTACT_HOURS=$NEXT_PUBLIC_CONTACT_HOURS NEXT_PUBLIC_CONTACT_LOCATION=$NEXT_PUBLIC_CONTACT_LOCATION
RUN pnpm install --frozen-lockfile && pnpm --filter @wms/web build
ENV NODE_ENV=production
WORKDIR /app/apps/web
EXPOSE 3000
CMD ["pnpm", "start"]
