# The API (NestJS). Built from the repository root:  docker build -f deploy/Dockerfile.api .
FROM node:22-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/* && corepack enable
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile && pnpm db:generate && pnpm --filter @wms/api build
ENV NODE_ENV=production
WORKDIR /app/apps/api
EXPOSE 4000
# start-api.sh updates the database first (prisma db push), then starts the server
CMD ["sh", "/app/deploy/start-api.sh"]
