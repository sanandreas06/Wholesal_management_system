# Copy this file to deploy/.env.production on the server and fill it in. Never commit the real file.
# Make the three secrets with:  openssl rand -hex 48     (run it once per line)
DOMAIN=shop.example.com
POSTGRES_PASSWORD=
JWT_SECRET=
AUDIT_SEAL_KEY=

# --- Optional: sign-in emails, social sign-in, refer & earn (see docs/deployment/sign-in-setup.md) ---
# Email codes: gmail (with the three GMAIL_ values), or brevo/resend (with MAIL_API_KEY); MAIL_FROM is the sender address
MAIL_PROVIDER=gmail
MAIL_FROM=sanshubster@gmail.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
MAIL_API_KEY=
MAIL_FROM_NAME=WHOLESTRA
# where Contact page messages are emailed (defaults to MAIL_FROM)
INQUIRY_TO=sanshubster@gmail.com
# Optional: smart replies for the assistant (an Anthropic API key from console.anthropic.com). Empty = built-in answers only.
ANTHROPIC_API_KEY=
# Most smart replies the whole server may ask for in one day (protects the bill). The model can be changed with ASSISTANT_MODEL.
ASSISTANT_DAILY_LIMIT=3000
# "Continue with Google / Facebook / LinkedIn" (leave a pair empty to hide that button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# For WHOLESTRA staff to confirm referral rewards (at least 24 characters; openssl rand -hex 24)
PLATFORM_ADMIN_KEY=
REFERRAL_MAX_USD=30
# Our contact details shown on the website and inside the app
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_HOURS=
NEXT_PUBLIC_CONTACT_LOCATION=
