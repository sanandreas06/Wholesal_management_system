NODE_ENV=development
DATABASE_URL=postgresql://wholesale:wholesale@localhost:5432/wholesale_management?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Do not edit these two by hand: `pnpm secrets:set` writes long random values here (and never shows them).
JWT_SECRET=change-this-development-secret
JWT_EXPIRES_IN=1d
# Audit log seal (tamper evidence). Written by `pnpm secrets:set`. Keep it private.
# Never change it by hand: old seals would fail the check. To change it, use `pnpm secrets:set` then `pnpm audit:rotate-key`.
# AUDIT_SEAL_KEY=
# Set to false to skip the database rule that blocks editing/deleting sealed audit rows.
# AUDIT_APPEND_ONLY=true
