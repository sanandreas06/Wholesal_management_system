generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id             String          @id @default(uuid())
  name           String
  code           String          @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  branches       Branch[]
  products       Product[]
  regions        Region[]
  roles          Role[]
  sales          Sale[]
  users          User[]
  categories     Category[]
  brands         Brand[]
  units          Unit[]
  suppliers      Supplier[]
  customers      Customer[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  inventories    Inventory[]
  stockMovements StockMovement[]
  stockTransfers StockTransfer[]
  stockCounts    StockCount[]
  payments       Payment[]
  saleReturns    SaleReturn[]
  expenseCategories ExpenseCategory[]
  importBatches  ImportBatch[]
  weeklySales    WeeklySale[]
  expenses       Expense[]
  deposits       Deposit[]
  varianceCases  VarianceCase[]
  branchClosings BranchClosing[]
  auditLogs      AuditLog[]
  auditChainHead AuditChainHead?
  productAliases ProductAlias[]
  // ---- company profile (Batch 29): what the owner fills in on the "Set up your organization profile" screen ----
  industry           String?
  country            String?
  stateProvince      String?
  address            String?   @db.Text
  phone              String?
  email              String?
  website            String?
  taxId              String?
  currency           String    @default("GHS")
  language           String    @default("en")
  timeZone           String    @default("Africa/Accra")
  inventoryStartDate DateTime? @db.Date
  /// First month of the financial year, for example "January" (Jan to Dec) or "April" (Apr to Mar)
  fiscalYearStart    String    @default("January")
  /// Small picture shown on invoices (already shrunk by the browser)
  logo               String?   @db.Text
  plan               String    @default("PILOT")
  /// True for the shared read-only demo company. Nobody can sign in to it with an email and password.
  isDemo             Boolean   @default(false)
  /// True from the moment a company signs itself up until the owner finishes the profile screen. Companies that existed before this batch are never "pending".
  setupPending       Boolean   @default(false)
  /// The code this company shares to refer other companies
  referralCode       String?   @unique
  referredByCode     String?
  referralsMade      Referral[] @relation("Referrer")
  referral           Referral?  @relation("Referred")
}

enum ReferralStatus {
  REGISTERED
  CONFIRMED
  PAID
  REJECTED
}

/// One company that signed up through another company's link. The reward is "up to US$30" and is set by WHOLESTRA staff once the new company is verified.
model Referral {
  id                String         @id @default(uuid())
  referrerOrgId     String
  referredOrgId     String         @unique
  code              String
  status            ReferralStatus @default(REGISTERED)
  rewardUsd         Decimal        @default(0) @db.Decimal(8, 2)
  note              String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  referrer          Organization   @relation("Referrer", fields: [referrerOrgId], references: [id], onDelete: Cascade)
  referred          Organization   @relation("Referred", fields: [referredOrgId], references: [id], onDelete: Cascade)

  @@index([referrerOrgId])
}

/// A one-time email code, kept only as a keyed fingerprint. Used for sign-in and for confirming a new account's email.
model OtpChallenge {
  id         String    @id @default(uuid())
  email      String
  purpose    String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

/// A Google, Facebook or LinkedIn account linked to a person.
model AuthIdentity {
  id             String   @id @default(uuid())
  userId         String
  provider       String
  providerUserId String
  email          String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Branch {
  id             String          @id @default(uuid())
  organizationId String
  name           String
  code           String
  location       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  regionId       String?
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  region         Region?         @relation(fields: [regionId], references: [id])
  sales          Sale[]
  users          User[]
  purchaseOrders PurchaseOrder[]
  inventories    Inventory[]
  stockMovements StockMovement[]
  transfersFrom  StockTransfer[] @relation("TransferFromBranch")
  transfersTo    StockTransfer[] @relation("TransferToBranch")
  stockCounts    StockCount[]
  expenses       Expense[]
  deposits       Deposit[]
  varianceCases  VarianceCase[]
  branchClosings BranchClosing[]
  importBatches  ImportBatch[]
  weeklySales    WeeklySale[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([regionId])
}

model User {
  id                    String          @id @default(uuid())
  organizationId        String
  branchId              String?
  email                 String          @unique
  name                  String
  passwordHash          String
  phone                 String?
  avatar                String?         @db.Text
  /// Set when an administrator created the account or reset the password: the person must choose their own at next sign-in.
  mustChangePassword    Boolean         @default(false)
  /// False for people who joined with Google, Facebook or LinkedIn and have not chosen a password yet.
  passwordSet           Boolean         @default(true)
  emailVerifiedAt       DateTime?
  /// Authenticator-app secret, encrypted. It only counts once totpEnabledAt is set.
  totpSecret            String?         @db.Text
  totpEnabledAt         DateTime?
  /// The newest 30-second step already used, so the same code cannot be used twice.
  totpLastStep          Int?
  /// SHA-256 fingerprints of the one-time recovery codes that have not been used yet.
  recoveryCodes         Json?
  identities            AuthIdentity[]
  savedViews            SavedView[]
  status                UserStatus      @default(ACTIVE)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  sales                 Sale[]
  branch                Branch?         @relation(fields: [branchId], references: [id])
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles             UserRole[]
  goodsReceipts         GoodsReceipt[]
  stockMovements        StockMovement[]
  createdStockTransfers StockTransfer[]
  createdStockCounts    StockCount[]
  payments              Payment[]
  paymentsReceived      Payment[]       @relation("PaymentsReceived")
  saleReturnsCreated    SaleReturn[]    @relation("SaleReturnsCreated")
  expensesCreated       Expense[]       @relation("ExpensesCreated")
  expensesReviewed      Expense[]       @relation("ExpensesReviewed")
  depositsCreated       Deposit[]       @relation("DepositsCreated")
  varianceCasesResolved VarianceCase[]  @relation("VarianceResolved")
  closingsDone          BranchClosing[] @relation("ClosingsDone")
  importsUploaded       ImportBatch[]   @relation("ImportsUploaded")
  saleReturns           SaleReturn[]

  @@index([organizationId])
  @@index([branchId])
  auditLogs      AuditLog[]
}

model Product {
  id                 String              @id @default(uuid())
  organizationId     String
  sku                String
  name               String
  category           String?
  categoryId         String?
  brandId            String?
  unitId             String?
  unitPrice          Decimal             @db.Decimal(14, 2)
  costPrice          Decimal?            @db.Decimal(14, 2)
  stockQuantity      Int                 @default(0)
  reorderLevel       Int                 @default(10)
  /// Small picture (already shrunk by the browser) shown on the Home screen and product lists
  imageUrl           String?             @db.Text
  /// a small copy of the picture (about 128px) for lists, so long lists stay light
  imageThumb         String?             @db.Text
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  saleItems          SaleItem[]
  categoryRef        Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand              Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unit               Unit?               @relation(fields: [unitId], references: [id], onDelete: SetNull)
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]
  inventories        Inventory[]
  stockMovements     StockMovement[]
  stockTransferItems StockTransferItem[]
  stockCountItems    StockCountItem[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([categoryId])
  @@index([brandId])
  @@index([unitId])
  weeklySales    WeeklySale[]
  aliases        ProductAlias[]
}

model Sale {
  id             String       @id @default(uuid())
  organizationId String
  branchId       String
  userId         String
  customerId     String?
  invoiceNumber  String       @unique
  status         SaleStatus   @default(COMPLETED)
  totalAmount    Decimal      @db.Decimal(14, 2)
  soldAt         DateTime     @default(now())
  createdAt      DateTime     @default(now())
  branch         Branch       @relation(fields: [branchId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items          SaleItem[]
  payments       Payment[]
  returns        SaleReturn[]

  @@index([organizationId, soldAt])
  @@index([branchId, soldAt])
}

model SaleItem {
  id          String           @id @default(uuid())
  saleId      String
  productId   String
  quantity    Int
  unitPrice   Decimal          @db.Decimal(14, 2)
  unitCost    Decimal?         @db.Decimal(14, 2)
  lineTotal   Decimal          @db.Decimal(14, 2)
  product     Product          @relation(fields: [productId], references: [id])
  sale        Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  returnItems SaleReturnItem[]

  @@index([saleId])
  @@index([productId])
}

model Region {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  code           String
  description    String?
  status         RoleStatus   @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  branches       Branch[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Role {
  id             String           @id @default(uuid())
  organizationId String
  name           String
  code           String
  description    String?
  /// People with this role only see and work with the branch they belong to. Off = every branch.
  branchRestricted Boolean        @default(false)
  /// Largest expense this role may approve. Empty = any amount. Only matters for roles that have the Expenses "Approve" permission.
  expenseApprovalLimit Decimal?   @db.Decimal(14, 2)
  status         RoleStatus       @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  userRoles      UserRole[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Permission {
  id          String             @id @default(uuid())
  resource    PermissionResource
  action      PermissionAction
  description String?
  createdAt   DateTime           @default(now())
  roles       RolePermission[]

  @@unique([resource, action])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model Category {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Brand {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Unit {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

/// A named set of screen filters that belongs to one person and follows them to any browser.
model SavedView {
  id        String   @id @default(uuid())
  userId    String
  scope     String
  name      String
  state     Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, name])
  @@index([userId, scope])
}

model Supplier {
  id             String     @id @default(uuid())
  organizationId String
  name           String
  code           String
  phone          String?
  email          String?
  address        String?
  creditLimit    Decimal?   @db.Decimal(14, 2)
  creditDays     Int?
  leadTimeDays   Int?
  status         RoleStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts       Contact[]
  purchaseOrders PurchaseOrder[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Customer {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  code           String
  phone          String?
  email          String?
  address        String?
  creditLimit    Decimal?     @db.Decimal(14, 2)
  creditDays     Int?
  status         RoleStatus   @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  sales          Sale[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts       Contact[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Contact {
  id         String   @id @default(uuid())
  supplierId String?
  customerId String?
  name       String
  role       String?
  phone      String?
  email      String?
  createdAt  DateTime @default(now())

  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([customerId])
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

model PurchaseOrder {
  id             String              @id @default(uuid())
  organizationId String
  supplierId     String
  branchId       String
  orderNumber    String
  status         PurchaseOrderStatus @default(DRAFT)
  orderDate      DateTime            @default(now())
  expectedDate   DateTime?
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branch       Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  items        PurchaseOrderItem[]
  receipts     GoodsReceipt[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId])
  @@index([supplierId])
  @@index([branchId])
}

model PurchaseOrderItem {
  id               String  @id @default(uuid())
  purchaseOrderId  String
  productId        String
  quantityOrdered  Int
  quantityReceived Int     @default(0)
  unitCost         Decimal @db.Decimal(14, 2)

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  receiptItems  GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([productId])
}

model GoodsReceipt {
  id                    String   @id @default(uuid())
  organizationId        String
  purchaseOrderId       String
  receivedByUserId      String
  receivedAt            DateTime @default(now())
  supplierInvoiceNumber String?
  supplierInvoiceAmount Decimal? @db.Decimal(14, 2)
  notes                 String?
  createdAt             DateTime @default(now())

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  receivedBy    User               @relation(fields: [receivedByUserId], references: [id], onDelete: Restrict)
  items         GoodsReceiptItem[]

  @@index([organizationId])
  @@index([purchaseOrderId])
}

model GoodsReceiptItem {
  id                  String  @id @default(uuid())
  goodsReceiptId      String
  purchaseOrderItemId String
  productId           String
  quantityReceived    Int
  unitCost            Decimal @db.Decimal(14, 2)

  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([goodsReceiptId])
  @@index([purchaseOrderItemId])
}

model Inventory {
  id             String   @id @default(uuid())
  organizationId String
  productId      String
  branchId       String
  quantity       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId])
  @@index([organizationId])
  @@index([branchId])
}

enum StockMovementType {
  RECEIPT
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  SALE
  INITIAL
  COUNT_VARIANCE
  RETURN
}

model StockMovement {
  id                String            @id @default(uuid())
  organizationId    String
  productId         String
  branchId          String
  type              StockMovementType
  quantityDelta     Int
  resultingQuantity Int
  referenceType     String?
  referenceId       String?
  userId            String?
  notes             String?
  createdAt         DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([productId, branchId])
  @@index([branchId])
}

enum StockTransferStatus {
  DRAFT
  APPROVED
  DISPATCHED
  RECEIVED
  CANCELLED
}

enum StockCountStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model StockCount {
  id                String           @id @default(uuid())
  organizationId    String
  branchId          String
  countNumber       String
  status            StockCountStatus @default(DRAFT)
  notes             String?
  createdByUserId   String
  completedByUserId String?
  completedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  createdBy         User             @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch            Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  items             StockCountItem[]

  @@unique([organizationId, countNumber])
  @@index([organizationId])
  @@index([branchId])
}

model StockCountItem {
  id              String @id @default(uuid())
  stockCountId    String
  productId       String
  systemQuantity  Int
  countedQuantity Int?

  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([stockCountId])
  @@index([productId])
}

model StockTransfer {
  id                 String              @id @default(uuid())
  organizationId     String
  fromBranchId       String
  toBranchId         String
  transferNumber     String
  status             StockTransferStatus @default(DRAFT)
  notes              String?
  createdByUserId    String
  approvedByUserId   String?
  approvedAt         DateTime?
  dispatchedByUserId String?
  dispatchedAt       DateTime?
  receivedByUserId   String?
  receivedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromBranch   Branch              @relation("TransferFromBranch", fields: [fromBranchId], references: [id], onDelete: Restrict)
  toBranch     Branch              @relation("TransferToBranch", fields: [toBranchId], references: [id], onDelete: Restrict)
  createdBy    User                @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  items        StockTransferItem[]

  @@unique([organizationId, transferNumber])
  @@index([organizationId])
  @@index([fromBranchId])
  @@index([toBranchId])
}

model StockTransferItem {
  id              String @id @default(uuid())
  stockTransferId String
  productId       String
  quantity        Int

  stockTransfer StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([stockTransferId])
  @@index([productId])
}

enum PaymentMethod {
  CASH
  BANK
  MOBILE_MONEY
  CREDIT
}

model Payment {
  id               String        @id @default(uuid())
  organizationId   String
  saleId           String
  method           PaymentMethod
  amount           Decimal       @db.Decimal(14, 2)
  reference        String?
  receivedByUserId String
  receivedAt       DateTime      @default(now())
  createdAt        DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale         Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  receivedBy   User         @relation("PaymentsReceived", fields: [receivedByUserId], references: [id], onDelete: Restrict)
  user         User?        @relation(fields: [userId], references: [id])
  userId       String?

  @@index([saleId])
  @@index([organizationId])
}

model SaleReturn {
  id              String   @id @default(uuid())
  organizationId  String
  saleId          String
  reason          String
  createdByUserId String
  createdAt       DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale         Sale             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  createdBy    User             @relation("SaleReturnsCreated", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items        SaleReturnItem[]
  user         User?            @relation(fields: [userId], references: [id])
  userId       String?

  @@index([saleId])
  @@index([organizationId])
}

model SaleReturnItem {
  id           String @id @default(uuid())
  saleReturnId String
  saleItemId   String
  quantity     Int

  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id], onDelete: Restrict)

  @@index([saleReturnId])
  @@index([saleItemId])
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum PermissionAction {
  READ
  CREATE
  UPDATE
  DELETE
  APPROVE
  EXPORT
  IMPORT
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  userName       String?
  action         String
  entityType     String
  entityId       String?
  summary        String
  changes        Json?
  createdAt      DateTime     @default(now())
  seq            Int?
  prevHash       String?
  hash           String?
  sealedAt       DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([organizationId, seq])
  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([userId])
}

/// The newest seal for each organization, so removing the most recent entries from the log can be noticed.
model AuditChainHead {
  organizationId String       @id
  seq            Int
  hash           String
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum PermissionResource {
  DASHBOARD
  USERS
  ROLES
  ORGANIZATION
  REGIONS
  BRANCHES
  PRODUCTS
  CATEGORIES
  BRANDS
  UNITS
  SUPPLIERS
  CUSTOMERS
  PURCHASING
  GOODS_RECEIVING
  INVENTORY
  STOCK_COUNTS
  STOCK_TRANSFERS
  STOCK_ADJUSTMENTS
  SALES
  PAYMENTS
  RETURNS
  EXPENSES
  DEPOSITS
  RECONCILIATION
  VARIANCE_CASES
  BRANCH_CLOSING
  REPORTS
  EXCEL_IMPORT
  PROFIT
  AUDIT
  SETTINGS
  PERMISSIONS
}

// ============================================================
// BATCH 8 — FINANCE & RECONCILIATION
// ============================================================

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VarianceStatus {
  OPEN
  INVESTIGATING
  RESOLVED
}

model ExpenseCategory {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses       Expense[]

  @@unique([organizationId, name])
}

model Expense {
  id               String          @id @default(uuid())
  organizationId   String
  branchId         String
  categoryId       String
  amount           Decimal         @db.Decimal(14, 2)
  description      String
  expenseDate      DateTime
  status           ExpenseStatus   @default(PENDING)
  createdByUserId  String
  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime        @default(now())
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch           Branch          @relation(fields: [branchId], references: [id])
  category         ExpenseCategory @relation(fields: [categoryId], references: [id])
  createdBy        User            @relation("ExpensesCreated", fields: [createdByUserId], references: [id])
  reviewedBy       User?           @relation("ExpensesReviewed", fields: [reviewedByUserId], references: [id])

  @@index([organizationId, expenseDate])
  @@index([branchId, expenseDate])
}

// Money a branch actually banked / sent to the owner. Compared against
// the payments recorded on sales to find shortfalls.
model Deposit {
  id              String        @id @default(uuid())
  organizationId  String
  branchId        String
  method          PaymentMethod
  amount          Decimal       @db.Decimal(14, 2)
  reference       String?
  depositDate     DateTime
  createdByUserId String
  createdAt       DateTime      @default(now())
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch          Branch        @relation(fields: [branchId], references: [id])
  createdBy       User          @relation("DepositsCreated", fields: [createdByUserId], references: [id])

  @@index([organizationId, depositDate])
  @@index([branchId, depositDate])
}

// Opened automatically when a branch closing finds a material gap
// between expected collections and actual deposits for a payment method.
model VarianceCase {
  id               String         @id @default(uuid())
  organizationId   String
  branchId         String
  closingId        String?
  method           PaymentMethod
  periodStart      DateTime
  periodEnd        DateTime
  expectedAmount   Decimal        @db.Decimal(14, 2)
  actualAmount     Decimal        @db.Decimal(14, 2)
  difference       Decimal        @db.Decimal(14, 2)
  status           VarianceStatus @default(OPEN)
  explanation      String?
  resolution       String?
  resolvedByUserId String?
  resolvedAt       DateTime?
  createdAt        DateTime       @default(now())
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch           Branch         @relation(fields: [branchId], references: [id])
  closing          BranchClosing? @relation(fields: [closingId], references: [id])
  resolvedBy       User?          @relation("VarianceResolved", fields: [resolvedByUserId], references: [id])

  @@index([organizationId, status])
  @@index([branchId])
}

// A closed period for a branch. Once closed, deposits and expenses dated
// inside it can no longer be added.
model BranchClosing {
  id               String         @id @default(uuid())
  organizationId   String
  branchId         String
  periodStart      DateTime
  periodEnd        DateTime
  expectedAmount   Decimal        @db.Decimal(14, 2)
  depositedAmount  Decimal        @db.Decimal(14, 2)
  expensesAmount   Decimal        @db.Decimal(14, 2)
  differenceAmount Decimal        @db.Decimal(14, 2)
  notes            String?
  closedByUserId   String
  closedAt         DateTime       @default(now())
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch           Branch         @relation(fields: [branchId], references: [id])
  closedBy         User           @relation("ClosingsDone", fields: [closedByUserId], references: [id])
  varianceCases    VarianceCase[]

  @@unique([branchId, periodStart, periodEnd])
  @@index([organizationId, periodEnd])
}

// ============================================================
// BATCH 9 — EXCEL INTEGRATION
// Excel is an input channel; PostgreSQL stays the system of record.
// Imported weekly sales are stored separately from live POS-style sales
// and never change stock levels.
// ============================================================

enum ImportStatus {
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

model ImportBatch {
  id               String        @id @default(uuid())
  organizationId   String
  branchId         String
  periodStart      DateTime
  periodEnd        DateTime
  fileName         String
  fileHash         String
  sourceFile       Bytes?
  status           ImportStatus
  totalRows        Int           @default(0)
  importedRows     Int           @default(0)
  duplicateRows    Int           @default(0)
  errorRows        Int           @default(0)
  uploadedByUserId String
  createdAt        DateTime      @default(now())
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch           Branch        @relation(fields: [branchId], references: [id])
  uploadedBy       User          @relation("ImportsUploaded", fields: [uploadedByUserId], references: [id])
  errors           ImportRowError[]
  sales            WeeklySale[]

  @@index([organizationId, createdAt])
  @@index([branchId, periodStart])
}

model ProductAlias {
  id              String       @id @default(uuid())
  organizationId  String
  productId       String
  alias           String
  aliasKey        String
  createdByUserId String?
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([organizationId, aliasKey])
  @@index([productId])
}

model ImportRowError {
  id            String      @id @default(uuid())
  batchId       String
  rowNumber     Int
  message       String
  rawData       String?
  unmatchedText String?
  batch     ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
}

model WeeklySale {
  id             String       @id @default(uuid())
  organizationId String
  branchId       String
  batchId        String
  productId      String
  saleDate       DateTime
  quantity       Int
  unitPrice      Decimal      @db.Decimal(14, 2)
  lineTotal      Decimal      @db.Decimal(14, 2)
  fingerprint    String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch       @relation(fields: [branchId], references: [id])
  batch          ImportBatch  @relation(fields: [batchId], references: [id])
  product        Product      @relation(fields: [productId], references: [id])

  // Re-importing the same source row must never create a second record.
  @@unique([organizationId, fingerprint])
  @@index([branchId, saleDate])
  @@index([productId, saleDate])
}

/// A message sent from the Contact page. Kept for WHOLESTRA staff (not part of any company's data).
model Inquiry {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String
  company   String
  branches  String?
  subject   String
  message   String   @db.Text
  /// NEW, REPLIED or CLOSED
  status    String   @default("NEW")
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email, createdAt])
}

/// Someone who opened the demo company, with the shop or company name they typed. For WHOLESTRA staff (follow-up), not part of any company's data.
model DemoVisit {
  id        String   @id @default(uuid())
  company   String
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Settings that belong to the whole WHOLESTRA server rather than one company, such as the connected Gmail account that sends sign-in codes.
/// Values are encrypted with the server's key.
model PlatformSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
